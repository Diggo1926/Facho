# Desenvolvimento local (sem SSL)
DATABASE_URL=postgresql://user:password@localhost:5432/facho

# Produção Railway — adicione ?sslmode=require ao final da URL fornecida pelo Railway
# DATABASE_URL=postgresql://user:password@host:5432/facho?sslmode=require

JWT_SECRET=minimo_32_caracteres_aleatorios_aqui_abc123
JWT_REFRESH_SECRET=minimo_32_caracteres_aleatorios_diferente_xyz789
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development

# Criptografia dos dados sensíveis (CPF/RG nos contratos) — AES-256-GCM, IV 96 bits
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=gere_uma_chave_de_64_caracteres_hex_aqui_ex_abc123

# Cloudinary — armazenamento privado de PDFs de contratos
# Obtenha em: https://console.cloudinary.com/ > Settings > API Keys
# Os PDFs são enviados com type: 'authenticated' — nunca ficam com URL pública.
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=seu_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# Senha do usuário admin para o seed — mínimo 12 caracteres
# Se ausente, o seed gera uma senha aleatória e exibe UMA VEZ no console
# ADMIN_SEED_PASSWORD=
