generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  name              String
  createdAt         DateTime           @default(now())
  projects          Project[]
  references        Reference[]
  preferences       Preferences?
  refreshTokens     RefreshToken[]
  templates         ProjectTemplate[]
  contractTemplates ContractTemplate[]
}

model Project {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome         String
  tipo         String?
  complexidade String?
  cliente      String?
  descricao    String
  icone        String?
  status       String             @default("andamento")
  currentPhase Int                @default(1)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  phases       Phase[]
  references   ProjectReference[]
  sessionLogs  SessionLog[]
  contracts    Contract[]
}

model Phase {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  numero     Int
  nome       String
  status     String   @default("pendente")
  notas      String?
  resultado  Json?
  paleta     Json?
  tipografia Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, numero])
}

model Reference {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome          String
  link          String?
  categoria     String
  subcategoria  String?
  anotacoes     String?
  corFundo      String?
  tags          String[]           @default([])
  screenshotUrl String?
  createdAt     DateTime           @default(now())
  projects      ProjectReference[]
}

model ProjectReference {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  referenceId String
  reference   Reference @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  phaseNumero Int?

  @@unique([projectId, referenceId])
}

model Preferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stackFavorita    String?
  padroesCodigo    String?
  observacoesFixas String?
  updatedAt        DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SessionLog {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resumo            String
  contextoExportado Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model ContractTemplate {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String
  tipo      String
  corpo     String
  campos    Json       @default("[]")
  versao    Int        @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  contracts Contract[]
}

model Contract {
  id         String         @id @default(cuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId String
  template   ContractTemplate @relation(fields: [templateId], references: [id])
  titulo     String
  tipo       String
  dados      String
  status     String         @default("rascunho")
  versao     Int            @default(1)
  valorTotal Decimal?       @db.Decimal(12, 2)
  assinadoEm DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  files      ContractFile[]
}

model ContractFile {
  id             String   @id @default(cuid())
  contractId     String
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  tipoArquivo    String
  nomeArquivo    String
  mimeType       String
  tamanhoBytes   Int
  caminhoStorage String
  createdAt      DateTime @default(now())
}

model ProjectTemplate {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome         String
  tipo         String
  complexidade String?
  descricao    String?
  icone        String?
  fase1        Json?
  fase2        Json?
  fase3        Json?
  fase4        Json?
  fase5        Json?
  fase6        Json?
  fase7        Json?
  fase8        Json?
  createdAt    DateTime @default(now())
}
